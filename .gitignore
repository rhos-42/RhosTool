## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]uild/
[Ll]og/
[Ll]ogs/

*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json
artifacts/

# Platform tools (downloaded by setup script)
tools/platform-tools/
tools/platform-tools.zip
tools/libimobiledevice/

# Build / publish outputs (use installer\publish-portable.ps1)
dist/
src/RhosTool.App/Resources/platform-tools.zip

# Large download artifact — served via GitHub Releases when possible;
# local copy for Pages may exist under web/downloads/ (generated, optional commit)
# Prefer: gh release upload + downloadUrl pointing to the Release asset.

# Secrets / local auth (never commit)
**/appsettings.Local.json
**/config.local.json
.env
.env.*

# Screenshots / refs
_ref_unlocktool/
*.png

# OS
Thumbs.db
Desktop.ini
.DS_Store
