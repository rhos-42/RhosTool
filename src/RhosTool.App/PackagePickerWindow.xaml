<Window x:Class="RhosTool.App.PackagePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choisir un package"
        Width="520"
        Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinWidth="320"
        MinHeight="360"
        Background="#FF1E1E1E"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Border BorderBrush="#FF555555" BorderThickness="1" Padding="18">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0"
                 x:Name="TitleText"
                 Text="Sélectionner un package"
                 FontSize="16"
                 FontWeight="Bold"
                 Foreground="#FFF5F5F5"
                 Margin="0,0,0,4" />
      <TextBlock Grid.Row="1"
                 x:Name="HintText"
                 Text="Filtrez puis double-cliquez ou validez."
                 Foreground="#FFB0B0B0"
                 FontSize="12"
                 Margin="0,0,0,12"
                 TextWrapping="Wrap" />

      <Grid Grid.Row="2" Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="FilterBox"
                 Height="36"
                 Padding="10,8"
                 Background="#FF121212"
                 Foreground="#FFF5F5F5"
                 BorderBrush="#FF6A6A6A"
                 CaretBrush="#FFFFC107"
                 VerticalContentAlignment="Center"
                 TextChanged="FilterBox_TextChanged" />
        <CheckBox Grid.Column="1"
                  x:Name="ThirdPartyBox"
                  Content="Apps utilisateur"
                  Foreground="#FFE0E0E0"
                  VerticalAlignment="Center"
                  Margin="12,0,0,0"
                  Checked="ThirdPartyBox_Changed"
                  Unchecked="ThirdPartyBox_Changed" />
      </Grid>

      <Border Grid.Row="3"
              Background="#FF121212"
              BorderBrush="#FF5A5A5A"
              BorderThickness="1"
              CornerRadius="3">
        <ListBox x:Name="PackageList"
                 Background="Transparent"
                 Foreground="#FFF5F5F5"
                 BorderThickness="0"
                 FontFamily="Consolas"
                 FontSize="12"
                 MouseDoubleClick="PackageList_MouseDoubleClick">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="10,7" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="#33FFC107" />
                        <Setter Property="Foreground" Value="#FFFFC107" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
        </ListBox>
      </Border>

      <TextBlock Grid.Row="4"
                 x:Name="CountText"
                 Foreground="#FF888888"
                 FontSize="11"
                 Margin="0,8,0,12" />

      <Grid Grid.Row="5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0"
                Content="Saisie manuelle"
                HorizontalAlignment="Left"
                Background="Transparent"
                Foreground="#FFFFD54F"
                BorderThickness="0"
                Cursor="Hand"
                Click="Manual_Click" />
        <Button Grid.Column="1"
                Content="Annuler"
                Width="100"
                Height="36"
                Margin="0,0,8,0"
                Background="#FF2A2A2A"
                Foreground="#FFE0E0E0"
                BorderBrush="#FF666666"
                BorderThickness="1"
                Cursor="Hand"
                IsCancel="True"
                Click="Cancel_Click" />
        <Button Grid.Column="2"
                Content="Valider"
                Width="110"
                Height="36"
                Background="#FFFFC107"
                Foreground="#FF111111"
                BorderThickness="0"
                FontWeight="Bold"
                Cursor="Hand"
                IsDefault="True"
                Click="Ok_Click" />
      </Grid>
    </Grid>
  </Border>
</Window>
