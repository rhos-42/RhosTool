<Window x:Class="RhosTool.App.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RhosTool — Connexion"
        Width="420"
        Height="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FF2A2A2A"
        WindowStyle="SingleBorderWindow">
  <Border BorderBrush="#FF555555" BorderThickness="1" Padding="28,24">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
        <TextBlock Text="RhosTool"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#FFE8E8E8"
                   HorizontalAlignment="Center" />
        <TextBlock Text="Authentification en ligne (Supabase)"
                   FontSize="12"
                   Foreground="#FFB0B0B0"
                   HorizontalAlignment="Center"
                   Margin="0,6,0,0" />
      </StackPanel>

      <TextBlock x:Name="StatusText"
                 DockPanel.Dock="Bottom"
                 TextWrapping="Wrap"
                 Foreground="#FFFFAB40"
                 FontSize="11"
                 Margin="0,14,0,0"
                 MinHeight="36" />

      <StackPanel>
        <TextBlock Text="Email" Foreground="#FFCCCCCC" Margin="0,0,0,4" />
        <TextBox x:Name="EmailBox"
                 Height="32"
                 Padding="8,6"
                 Background="#FF1E1E1E"
                 Foreground="White"
                 BorderBrush="#FF666666"
                 CaretBrush="White" />

        <TextBlock Text="Mot de passe" Foreground="#FFCCCCCC" Margin="0,12,0,4" />
        <PasswordBox x:Name="PasswordBox"
                     Height="32"
                     Padding="8,6"
                     Background="#FF1E1E1E"
                     Foreground="White"
                     BorderBrush="#FF666666"
                     CaretBrush="White" />

        <TextBlock Text="Nom d'utilisateur (inscription)" Foreground="#FFCCCCCC" Margin="0,12,0,4" />
        <TextBox x:Name="UsernameBox"
                 Height="32"
                 Padding="8,6"
                 Background="#FF1E1E1E"
                 Foreground="White"
                 BorderBrush="#FF666666"
                 CaretBrush="White" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
          <Button x:Name="LoginButton"
                  Content="Connexion"
                  Width="120"
                  Height="34"
                  Margin="0,0,10,0"
                  Click="Login_Click"
                  Background="#FF1565C0"
                  Foreground="White"
                  BorderThickness="0"
                  FontWeight="SemiBold"
                  Cursor="Hand"
                  IsDefault="True" />
          <Button x:Name="RegisterButton"
                  Content="Créer un compte"
                  Width="140"
                  Height="34"
                  Click="Register_Click"
                  Background="#FF424242"
                  Foreground="White"
                  BorderThickness="0"
                  Cursor="Hand" />
        </StackPanel>

        <Button Content="Ouvrir le dossier config"
                Margin="0,14,0,0"
                HorizontalAlignment="Center"
                Background="Transparent"
                Foreground="#FF90CAF9"
                BorderThickness="0"
                Cursor="Hand"
                Click="OpenConfigFolder_Click" />
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
