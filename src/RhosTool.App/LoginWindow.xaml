<Window x:Class="RhosTool.App.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="RhosTool — Connexion"
        Width="460"
        Height="620"
        MinWidth="340"
        MinHeight="420"
        WindowStartupLocation="Manual"
        ResizeMode="CanResize"
        WindowStyle="None"
        Background="#FF1A1A1A"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="32"
                        ResizeBorderThickness="6"
                        GlassFrameThickness="0"
                        CornerRadius="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <ControlTemplate x:Key="RoundedTextBox" TargetType="TextBox">
      <Border x:Name="Bd"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="4"
              SnapsToDevicePixels="True">
        <ScrollViewer x:Name="PART_ContentHost"
                      Margin="{TemplateBinding Padding}"
                      VerticalAlignment="Center" />
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter TargetName="Bd" Property="BorderBrush" Value="#FFFFC107" />
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter TargetName="Bd" Property="BorderBrush" Value="#FFFFC107" />
          <Setter TargetName="Bd" Property="Background" Value="#FF141414" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.5" />
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="RoundedPasswordBox" TargetType="PasswordBox">
      <Border x:Name="Bd"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="4"
              SnapsToDevicePixels="True">
        <ScrollViewer x:Name="PART_ContentHost"
                      Margin="{TemplateBinding Padding}"
                      VerticalAlignment="Center" />
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter TargetName="Bd" Property="BorderBrush" Value="#FFFFC107" />
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter TargetName="Bd" Property="BorderBrush" Value="#FFFFC107" />
          <Setter TargetName="Bd" Property="Background" Value="#FF141414" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.5" />
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="LoginField" TargetType="TextBox">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Height" Value="42" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Background" Value="#FF121212" />
      <Setter Property="Foreground" Value="#FFF5F5F5" />
      <Setter Property="BorderBrush" Value="#FF6A6A6A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CaretBrush" Value="#FFFFC107" />
      <Setter Property="SelectionBrush" Value="#88FFC107" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template" Value="{StaticResource RoundedTextBox}" />
    </Style>

    <Style x:Key="LoginPassword" TargetType="PasswordBox">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Height" Value="42" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Background" Value="#FF121212" />
      <Setter Property="Foreground" Value="#FFF5F5F5" />
      <Setter Property="BorderBrush" Value="#FF6A6A6A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CaretBrush" Value="#FFFFC107" />
      <Setter Property="SelectionBrush" Value="#88FFC107" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template" Value="{StaticResource RoundedPasswordBox}" />
    </Style>

    <Style x:Key="LoginLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FFBDBDBD" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="1,0,0,7" />
    </Style>

    <Style x:Key="PrimaryLoginButton" TargetType="Button">
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Background" Value="#FFFFC107" />
      <Setter Property="Foreground" Value="#FF111111" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    CornerRadius="4"
                    Padding="16,0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextBlock.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FFFFD54F" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FFFF9800" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryLoginButton" TargetType="Button">
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#FFFFC107" />
      <Setter Property="BorderBrush" Value="#FFFFC107" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4"
                    Padding="16,0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextBlock.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#33FFC107" />
                <Setter Property="Foreground" Value="#FFFFECB3" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FFFFC107" />
                <Setter Property="Foreground" Value="#FF111111" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#FFFFD54F" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <TextBlock x:Name="Txt"
                       Text="{TemplateBinding Content}"
                       Foreground="{TemplateBinding Foreground}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Txt" Property="TextDecorations" Value="Underline" />
                <Setter Property="Foreground" Value="#FFFFC107" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border BorderBrush="#FF555555" BorderThickness="1">
    <Grid>
      <Grid.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#FF1A1A1A" Offset="0" />
          <GradientStop Color="#FF242018" Offset="0.55" />
          <GradientStop Color="#FF1E1E1E" Offset="1" />
        </LinearGradientBrush>
      </Grid.Background>
      <Grid.RowDefinitions>
        <RowDefinition Height="32" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Rectangle Grid.RowSpan="2" Opacity="0.14" IsHitTestVisible="False">
        <Rectangle.Fill>
          <DrawingBrush TileMode="Tile" Viewport="0,0,12,12" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
              <GeometryDrawing Geometry="M0,0 H12 M0,0 V12">
                <GeometryDrawing.Pen>
                  <Pen Brush="#FF8A8A8A" Thickness="0.55" />
                </GeometryDrawing.Pen>
              </GeometryDrawing>
            </DrawingBrush.Drawing>
          </DrawingBrush>
        </Rectangle.Fill>
      </Rectangle>

      <Border Grid.Row="0"
              Background="#FF2B2B2B"
              BorderBrush="#FF404040"
              BorderThickness="0,0,0,1"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False">
            <Border Width="8" Height="8" CornerRadius="4" Background="#FFFFC107" Margin="0,0,8,0" />
            <TextBlock Text="RhosTool"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#FFE8E8E8"
                       VerticalAlignment="Center" />
          </StackPanel>
          <Button HorizontalAlignment="Right"
                  Style="{StaticResource CaptionCloseButton}"
                  ToolTip="Fermer"
                  Click="Close_Click"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Path Stroke="#FFFFFFFF" StrokeThickness="1" Width="10" Height="10"
                  Stretch="None" Data="M 0,0 L 10,10 M 10,0 L 0,10" />
          </Button>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Padding="0">
        <Grid Margin="16,16,16,16">
          <Border x:Name="FormCard"
                  MaxWidth="400"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Background="#E6252525"
                  BorderBrush="#FF5A5A5A"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="28,24">
            <StackPanel>
              <StackPanel HorizontalAlignment="Center" Margin="0,0,0,22">
                <Border Width="52" Height="52"
                        CornerRadius="26"
                        Background="#FF2A2408"
                        BorderBrush="#FFFFC107"
                        BorderThickness="2"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,12">
                  <TextBlock Text="R"
                             FontSize="24"
                             FontWeight="Bold"
                             Foreground="#FFFFC107"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="RhosTool"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#FFF5F5F5"
                           HorizontalAlignment="Center" />
                <Border Width="36" Height="2" Background="#FFFFC107"
                        HorizontalAlignment="Center" Margin="0,10,0,10" CornerRadius="1" />
                <TextBlock x:Name="SubtitleText"
                           Text="Connexion"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#FFFFD54F"
                           HorizontalAlignment="Center" />
              </StackPanel>

              <StackPanel x:Name="LoginPanel">
                <TextBlock Text="Nom d'utilisateur" Style="{StaticResource LoginLabel}" />
                <TextBox x:Name="LoginUserBox" Style="{StaticResource LoginField}" />

                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Mot de passe" Style="{StaticResource LoginLabel}" VerticalAlignment="Bottom" />
                  <Button Grid.Column="1"
                          Content="Mot de passe oublié ?"
                          Style="{StaticResource LinkButton}"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom"
                          Margin="8,0,0,7"
                          Click="ShowForgot_Click" />
                </Grid>
                <PasswordBox x:Name="LoginPasswordBox" Style="{StaticResource LoginPassword}" />

                <Button x:Name="LoginButton"
                        Content="CONNEXION"
                        Style="{StaticResource PrimaryLoginButton}"
                        Margin="0,20,0,0"
                        Click="Login_Click"
                        IsDefault="True" />

                <Grid Margin="0,16,0,16">
                  <Border Height="1" Background="#FF444444" VerticalAlignment="Center" />
                  <Border HorizontalAlignment="Center" Background="#FF252525" Padding="12,0">
                    <TextBlock Text="ou" Foreground="#FF888888" FontSize="11" FontWeight="SemiBold" />
                  </Border>
                </Grid>

                <Button Content="Créer un compte"
                        Style="{StaticResource SecondaryLoginButton}"
                        Click="ShowActivate_Click" />
              </StackPanel>

              <StackPanel x:Name="ActivatePanel" Visibility="Collapsed">
                <TextBlock Text="Email" Style="{StaticResource LoginLabel}" />
                <TextBox x:Name="ActivateEmailBox" Style="{StaticResource LoginField}" />

                <TextBlock Text="Nom d'utilisateur" Style="{StaticResource LoginLabel}" Margin="0,14,0,7" />
                <TextBox x:Name="ActivateUserBox" Style="{StaticResource LoginField}" />

                <TextBlock Text="Mot de passe" Style="{StaticResource LoginLabel}" Margin="0,14,0,7" />
                <PasswordBox x:Name="ActivatePasswordBox" Style="{StaticResource LoginPassword}" />

                <Button x:Name="ActivateButton"
                        Content="ENREGISTRER"
                        Style="{StaticResource PrimaryLoginButton}"
                        Margin="0,20,0,0"
                        Click="Activate_Click" />

                <Button Content="← Retour à la connexion"
                        Style="{StaticResource LinkButton}"
                        HorizontalAlignment="Center"
                        Margin="0,14,0,0"
                        Padding="8,4"
                        Click="ShowLogin_Click" />
              </StackPanel>

              <StackPanel x:Name="ForgotPanel" Visibility="Collapsed">
                <TextBlock Text="Saisissez l'email associé à votre compte. Un lien de réinitialisation vous sera envoyé."
                           Foreground="#FF9E9E9E"
                           FontSize="12"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,0,0,16"
                           LineHeight="18" />

                <TextBlock Text="Email" Style="{StaticResource LoginLabel}" />
                <TextBox x:Name="ForgotEmailBox" Style="{StaticResource LoginField}" />

                <Button x:Name="ForgotButton"
                        Content="ENVOYER LE LIEN"
                        Style="{StaticResource PrimaryLoginButton}"
                        Margin="0,20,0,0"
                        Click="Forgot_Click" />

                <Button Content="← Retour à la connexion"
                        Style="{StaticResource LinkButton}"
                        HorizontalAlignment="Center"
                        Margin="0,14,0,0"
                        Padding="8,4"
                        Click="ShowLogin_Click" />
              </StackPanel>

              <Border x:Name="StatusBorder"
                      Margin="0,16,0,0"
                      Background="#FF1A1A1A"
                      BorderBrush="#FF3A3A3A"
                      BorderThickness="1"
                      CornerRadius="4"
                      Padding="12,10"
                      MinHeight="36"
                      Visibility="Collapsed">
                <TextBlock x:Name="StatusText"
                           TextWrapping="Wrap"
                           Foreground="#FFFFAB40"
                           FontSize="11"
                           TextAlignment="Center"
                           VerticalAlignment="Center" />
              </Border>
            </StackPanel>
          </Border>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Border>
</Window>
